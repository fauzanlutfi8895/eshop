# ==============================================
# Next.js Frontend Environment Variables - EXAMPLE
# ==============================================
# Copy this to apps/user-ui/.env, apps/seller-ui/.env, apps/admin-ui/.env
# and fill in your values

# ==============================================
# API CONFIGURATION
# ==============================================
# For local development (Docker)
NEXT_PUBLIC_API_URL=http://localhost:4000

# For production
# NEXT_PUBLIC_API_URL=https://api.yourproduction.com

# ==============================================
# WEBSOCKET
# ==============================================
NEXT_PUBLIC_WS_URL=http://localhost:3007

# ==============================================
# STRIPE (Client-side)
# ==============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ==============================================
# IMAGEKIT (Client-side)
# ==============================================
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ==============================================
# APPLICATION
# ==============================================
NEXT_PUBLIC_APP_NAME=E-Shop
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# ANALYTICS
# ==============================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# ==============================================
# FEATURE FLAGS
# ==============================================
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ==============================================
# SEO & METADATA
# ==============================================
NEXT_PUBLIC_SITE_NAME=E-Shop
NEXT_PUBLIC_SITE_DESCRIPTION=Your one-stop e-commerce solution
NEXT_PUBLIC_SITE_KEYWORDS=e-commerce,shopping,marketplace

# ==============================================
# BUILD CONFIGURATION
# ==============================================
# Don't modify these unless you know what you're doing
NEXT_TELEMETRY_DISABLED=1
