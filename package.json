{
  "name": "@eshop/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx nx run-many --target=serve -all -maxParallel=10",
    "postinstall": "node scripts/copy-tf.js",
    "auth-docs": "cd apps/auth-service/src && node swagger.js",
    "product-docs": "cd apps/product-service/src && node swagger.js",
    "user-ui": "npx nx run-many --target=dev --all --projects=user-ui --port=3000",
    "seller-ui": "npx nx run-many --target=dev --all --projects=seller-ui --port=3001",
    "admin-ui": "npx nx run-many --target=dev --all --projects=admin-ui --port=3002",
    "docker:build": "docker-compose build",
    "docker:build:nocache": "docker-compose build --no-cache",
    "docker:up": "docker-compose up",
    "docker:up:d": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:test": "pwsh -File scripts/docker-build.ps1 -Test",
    "build:all": "npx nx run-many --target=build --all --prod",
    "test:local": "pwsh -File scripts/test-local.ps1",
    "test:local:quick": "pwsh -File scripts/test-local.ps1 -Quick"
  },
  "private": true,
