# ==============================================
# E-Shop Environment Variables - EXAMPLE
# ==============================================
# Copy this file to .env and fill in your values
# Never commit the actual .env file to git!

# ==============================================
# DATABASE
# ==============================================
DATABASE_URL="postgresql://username:password@localhost:5432/eshop_db?schema=public"

# ==============================================
# JWT & AUTHENTICATION
# ==============================================
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="30d"

# ==============================================
# KAFKA
# ==============================================
KAFKA_BROKERS="kafka:29092"
KAFKA_CLIENT_ID="eshop"
KAFKA_GROUP_ID="eshop-group"

# ==============================================
# REDIS (if used)
# ==============================================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ==============================================
# EMAIL SERVICE
# ==============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@eshop.com"

# ==============================================
# FILE UPLOAD / STORAGE
# ==============================================
IMAGEKIT_PUBLIC_KEY="your_public_key"
IMAGEKIT_PRIVATE_KEY="your_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# ==============================================
# PAYMENT GATEWAY (Stripe)
# ==============================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ==============================================
# API CONFIGURATION
# ==============================================
API_PORT=4000
AUTH_SERVICE_URL="http://auth-service:3000"
PRODUCT_SERVICE_URL="http://product-service:3001"
USER_SERVICE_URL="http://user-service:3002"
ADMIN_SERVICE_URL="http://admin-service:3003"
ORDER_SERVICE_URL="http://order-service:3004"
SELLER_SERVICE_URL="http://seller-service:3005"
RECOMMENDATION_SERVICE_URL="http://recommendation-service:3006"
CHATTING_SERVICE_URL="http://chatting-service:3007"

# ==============================================
# WEBSOCKET
# ==============================================
WS_PORT=3007
WS_PATH="/socket.io"

# ==============================================
# CORS
# ==============================================
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3010,http://localhost:3011,http://localhost:3012"

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# ==============================================
# APPLICATION
# ==============================================
NODE_ENV="development"
APP_NAME="E-Shop"
APP_URL="http://localhost:4000"

# ==============================================
# RECOMMENDATION SERVICE (TensorFlow)
# ==============================================
MODEL_PATH="./models/recommendation"
RECOMMENDATION_THRESHOLD=0.7

# ==============================================
# ADMIN SERVICE
# ==============================================
ADMIN_EMAIL="admin@eshop.com"
ADMIN_PASSWORD="change-this-admin-password"

# ==============================================
# SESSION & COOKIES
# ==============================================
SESSION_SECRET="your-session-secret-key"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# ==============================================
# MONITORING & ANALYTICS
# ==============================================
SENTRY_DSN=""
GOOGLE_ANALYTICS_ID=""

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_EMAIL_VERIFICATION="true"
ENABLE_RECOMMENDATIONS="true"
ENABLE_CHAT="true"
ENABLE_ANALYTICS="false"
